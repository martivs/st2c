(* Краевые случаи FOR: шаг BY, отрицательное направление, выражение в TO,
   вложенные циклы и цикл, доходящий до верхней границы INT.

   Последний цикл — регрессия на конкретный баг: если счётчик в
   сгенерированном C имеет тип int16_t, то на 32767 прибавление шага
   обрезается в -32768, условие снова истинно и цикл не завершается никогда.
   Счётчик обязан быть шире переменной цикла. *)
PROGRAM ForEdge
VAR
    i : INT;
    j : INT;
    up : INT;
    down : INT;
    nested : INT;
    limit : INT := 4;
    edge : INT;
END_VAR

up := 0;
FOR i := 1 TO 9 BY 2 DO         // 1, 3, 5, 7, 9
    up := up + i;               // 25
END_FOR

down := 0;
FOR i := 10 TO 1 BY -3 DO       // 10, 7, 4, 1 — направление по знаку шага
    down := down + i;           // 22
END_FOR

nested := 0;
FOR i := 1 TO limit DO          // граница — переменная, а не литерал
    FOR j := 1 TO i DO          // вложенность: временные не должны конфликтовать
        nested := nested + 1;   // 1 + 2 + 3 + 4 = 10
    END_FOR
END_FOR

edge := 0;
FOR i := 32760 TO 32767 DO      // верхняя граница INT
    edge := edge + 1;           // 8
END_FOR

END_PROGRAM
