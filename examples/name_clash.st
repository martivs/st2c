(* Имена ST, конфликтующие с именами в сгенерированном C.

   Две разные опасности (решение 8 плана):
     1. Ключевые слова C, не являющиеся ключевыми словами ST: switch, default,
        static, struct. (int и for сюда не годятся — они ключевые слова и в
        ST, так что переменными быть не могут.) Такие имена префиксуются.
     2. self (параметр функции шага) и имена с префиксом __ — в C они
        зарезервированы за реализацией, а codegen порождает из них свои
        временные (__i0, __end0, __step0). Любое имя на __ переименовывается
        всегда.

   Цикл в конце — регрессия на переименование: если codegen смешает
   пользовательский __step с собственной временной цикла или переименует поле
   в объявлении, но не в выражении, сумма получится другой. *)
PROGRAM NameClash
VAR
    switch, default, static : INT;
    struct : INT := 1;
    self : INT := 2;
    __end : INT := 3;
    __step : INT := 4;
    i : INT;
    total : INT;
END_VAR

switch := 10;
default := 20;
static := 30;

total := switch + default + static + struct + self + __end + __step;   // 70

FOR i := 1 TO 3 DO
    total := total + __step;    // 70 + 4 * 3 = 82
END_FOR

END_PROGRAM
