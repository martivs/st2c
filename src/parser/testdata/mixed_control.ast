Function(StopAt : INT)
  VarBlock(VAR_INPUT)
    VarDecl(n : INT)
  If
    Cond:
      Binary(=)
        Binary(MOD)
          Ident(n)
          Int(2)
        Int(0)
    Then:
      Assign
        Target:
          Ident(StopAt)
        Value:
          Int(3)
    ElsIf:
      Cond:
        Binary(>)
          Ident(n)
          Int(0)
      Then:
        Assign
          Target:
            Ident(StopAt)
          Value:
            Int(2)
    Else:
      Assign
        Target:
          Ident(StopAt)
        Value:
          Int(1)
Function(FirstSquare : INT)
  VarBlock(VAR_INPUT)
    VarDecl(target : REAL)
  VarBlock(VAR_TEMP)
    VarDecl(k : INT)
  For(k)
    Start:
      Int(1)
    End:
      Int(5)
    Do:
      Case
        Selector:
          Binary(MOD)
            Ident(k)
            Int(3)
        Branch(0):
        Else:
          If
            Cond:
              Binary(>=)
                Binary(**)
                  Ident(k)
                  Int(2)
                Ident(target)
            Then:
              Assign
                Target:
                  Ident(FirstSquare)
                Value:
                  Ident(k)
              Return
FunctionBlock(Sweep)
  VarBlock(VAR_INPUT)
    VarDecl(stop : INT)
  VarBlock(VAR_OUTPUT)
    VarDecl(count : INT)
  VarBlock(VAR)
    VarDecl(i, j : INT)
  Assign
    Target:
      Ident(count)
    Value:
      Int(0)
  For(i)
    Start:
      Int(1)
    End:
      Int(3)
    Do:
      Assign
        Target:
          Ident(j)
        Value:
          Int(0)
      Repeat
        Body:
          Assign
            Target:
              Ident(j)
            Value:
              Binary(+)
                Ident(j)
                Int(1)
          Case
            Selector:
              Binary(MOD)
                Ident(j)
                Int(3)
            Branch(1):
              Assign
                Target:
                  Ident(count)
                Value:
                  Binary(+)
                    Ident(count)
                    Int(1)
            Branch(2):
              While
                Cond:
                  Bool(TRUE)
                Body:
                  Case
                    Selector:
                      Ident(i)
                    Branch(1..2):
                      Assign
                        Target:
                          Ident(count)
                        Value:
                          Binary(+)
                            Ident(count)
                            Int(10)
                      Exit
                    Else:
                      Assign
                        Target:
                          Ident(count)
                        Value:
                          Binary(+)
                            Ident(count)
                            Int(100)
                      Exit
              Case
                Selector:
                  Ident(i)
                Branch(2):
                  Exit
            Else:
              Exit
          Assign
            Target:
              Ident(count)
            Value:
              Binary(+)
                Ident(count)
                Int(1)
        Until:
          Binary(>=)
            Ident(j)
            Ident(stop)
      If
        Cond:
          Binary(>=)
            Ident(i)
            Ident(stop)
        Then:
          Exit
Program(MixedControl)
  VarBlock(VAR)
    VarDecl(scan, first, again, total, found, tail : INT)
    VarDecl(scaled : REAL)
    VarDecl(valid : BOOL)
    VarDecl(worker : Sweep)
  Assign
    Target:
      Ident(scan)
    Value:
      Binary(+)
        Ident(scan)
        Int(1)
  CallStmt
    Call
      Callee:
        Ident(worker)
      Arg(stop :=)
        Call
          Callee:
            Ident(StopAt)
          Arg
            Ident(scan)
      Arg(count =>)
        Ident(first)
  CallStmt
    Call
      Callee:
        Ident(worker)
      Arg(stop :=)
        Int(2)
      Arg(count =>)
        Ident(again)
  Assign
    Target:
      Ident(total)
    Value:
      Binary(+)
        Binary(+)
          Ident(total)
          Ident(first)
        Ident(again)
  Assign
    Target:
      Ident(found)
    Value:
      Call
        Callee:
          Ident(FirstSquare)
        Arg
          Binary(**)
            Ident(scan)
            Int(2)
  Assign
    Target:
      Ident(scaled)
    Value:
      Binary(/)
        Call
          Callee:
            Ident(INT_TO_REAL)
          Arg
            Ident(first)
        Int(4)
  Assign
    Target:
      Ident(valid)
    Value:
      Binary(AND)
        Binary(AND)
          Binary(=)
            Ident(again)
            Int(25)
          Binary(>)
            Ident(found)
            Int(0)
        Unary(NOT)
          Binary(=)
            Binary(MOD)
              Ident(found)
              Int(3)
            Int(0)
  Case
    Selector:
      Ident(scan)
    Branch(2):
      Return
  Assign
    Target:
      Ident(tail)
    Value:
      Binary(+)
        Ident(tail)
        Int(1)
