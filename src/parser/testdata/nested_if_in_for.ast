Program(NestedIfInFor)
  VarBlock(VAR)
    VarDecl(i : INT)
    VarDecl(sum : INT)
    VarDecl(flag : INT)
  Assign
    Target:
      Ident(sum)
    Value:
      Int(0)
  Assign
    Target:
      Ident(flag)
    Value:
      Int(0)
  For(i)
    Start:
      Int(1)
    End:
      Int(10)
    Do:
      If
        Cond:
          Binary(>)
            Ident(i)
            Int(5)
        Then:
          Assign
            Target:
              Ident(sum)
            Value:
              Binary(+)
                Ident(sum)
                Ident(i)
        Else:
          Assign
            Target:
              Ident(flag)
            Value:
              Binary(+)
                Ident(flag)
                Int(1)
