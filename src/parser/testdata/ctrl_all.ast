Function(Digits : INT)
  VarBlock(VAR_INPUT)
    VarDecl(v : INT)
  VarBlock(VAR)
    VarDecl(n : INT)
    VarDecl(c : INT)
  Assign
    Target:
      Ident(n)
    Value:
      Ident(v)
  Assign
    Target:
      Ident(c)
    Value:
      Int(0)
  Repeat
    Body:
      Assign
        Target:
          Ident(c)
        Value:
          Binary(+)
            Ident(c)
            Int(1)
      Assign
        Target:
          Ident(n)
        Value:
          Binary(/)
            Ident(n)
            Int(10)
    Until:
      Binary(=)
        Ident(n)
        Int(0)
  Assign
    Target:
      Ident(Digits)
    Value:
      Ident(c)
FunctionBlock(Drain)
  VarBlock(VAR_INPUT)
    VarDecl(inflow : INT)
  VarBlock(VAR_OUTPUT)
    VarDecl(level : INT)
    VarDecl(steps : INT)
  Assign
    Target:
      Ident(level)
    Value:
      Binary(+)
        Ident(level)
        Ident(inflow)
  Assign
    Target:
      Ident(steps)
    Value:
      Int(0)
  While
    Cond:
      Binary(>)
        Ident(level)
        Int(10)
    Body:
      Assign
        Target:
          Ident(level)
        Value:
          Binary(-)
            Ident(level)
            Int(4)
      Assign
        Target:
          Ident(steps)
        Value:
          Binary(+)
            Ident(steps)
            Int(1)
Function(StepsTo : INT)
  VarBlock(VAR_INPUT)
    VarDecl(limit : INT)
  VarBlock(VAR)
    VarDecl(n : INT)
    VarDecl(acc : INT)
  While
    Cond:
      Binary(<)
        Ident(n)
        Int(100)
    Body:
      Assign
        Target:
          Ident(n)
        Value:
          Binary(+)
            Ident(n)
            Int(1)
      Assign
        Target:
          Ident(acc)
        Value:
          Binary(+)
            Ident(acc)
            Ident(n)
      If
        Cond:
          Binary(>)
            Ident(acc)
            Ident(limit)
        Then:
          Assign
            Target:
              Ident(StepsTo)
            Value:
              Ident(n)
          Exit
Function(Ripe : BOOL)
  VarBlock(VAR_INPUT)
    VarDecl(v : INT)
  Assign
    Target:
      Ident(Ripe)
    Value:
      Binary(>=)
        Ident(v)
        Int(4)
FunctionBlock(Ramp)
  VarBlock(VAR_INPUT)
    VarDecl(target : INT)
  VarBlock(VAR_OUTPUT)
    VarDecl(speed : INT)
    VarDecl(ticks : INT)
    VarDecl(atTop : BOOL)
  Assign
    Target:
      Ident(ticks)
    Value:
      Int(0)
  Repeat
    Body:
      If
        Cond:
          Binary(>=)
            Ident(ticks)
            Int(2)
        Then:
          Exit
      Assign
        Target:
          Ident(speed)
        Value:
          Binary(+)
            Ident(speed)
            Int(3)
      Assign
        Target:
          Ident(ticks)
        Value:
          Binary(+)
            Ident(ticks)
            Int(1)
    Until:
      Binary(>=)
        Ident(speed)
        Ident(target)
  Assign
    Target:
      Ident(atTop)
    Value:
      Binary(>=)
        Ident(speed)
        Ident(target)
Program(CtrlAll)
  VarBlock(VAR)
    VarDecl(cycle : INT)
    VarDecl(t : INT)
      Init:
        Int(5)
    VarDecl(first : INT)
    VarDecl(mode : INT)
    VarDecl(band : INT)
      Init:
        Int(99)
    VarDecl(sign : INT)
    VarDecl(legacy : INT)
    VarDecl(whileZero : INT)
    VarDecl(repeatOne : INT)
    VarDecl(sum : INT)
    VarDecl(k : INT)
    VarDecl(rep : INT)
    VarDecl(found : INT)
    VarDecl(i : INT)
    VarDecl(j : INT)
    VarDecl(outerCnt : INT)
    VarDecl(innerCnt : INT)
    VarDecl(spins : INT)
    VarDecl(acc : INT)
    VarDecl(r : REAL)
    VarDecl(halves : INT)
    VarDecl(flag : BOOL)
    VarDecl(tries : INT)
    VarDecl(digitsZero : INT)
    VarDecl(digitsBig : INT)
    VarDecl(tank : Drain)
    VarDecl(lvl : INT)
    VarDecl(drained : INT)
    VarDecl(pick : INT)
    VarDecl(taps : INT)
    VarDecl(wOuter : INT)
    VarDecl(wInner : INT)
    VarDecl(wStep : INT)
    VarDecl(rOuter : INT)
    VarDecl(rInner : INT)
    VarDecl(rStep : INT)
    VarDecl(stepsUsed : INT)
    VarDecl(grown : INT)
    VarDecl(armed : BOOL)
    VarDecl(paces : INT)
    VarDecl(ramp : Ramp)
    VarDecl(rampSpeed : INT)
    VarDecl(rampTicks : INT)
    VarDecl(rampTop : BOOL)
    VarDecl(gear : INT)
  Assign
    Target:
      Ident(cycle)
    Value:
      Binary(+)
        Ident(cycle)
        Int(1)
  If
    Cond:
      Binary(<)
        Ident(t)
        Int(10)
    Then:
      Assign
        Target:
          Ident(first)
        Value:
          Int(1)
    ElsIf:
      Cond:
        Binary(<)
          Ident(t)
          Int(20)
      Then:
        Assign
          Target:
            Ident(first)
          Value:
            Int(2)
    ElsIf:
      Cond:
        Binary(<)
          Ident(t)
          Int(30)
      Then:
        Assign
          Target:
            Ident(first)
          Value:
            Int(3)
  If
    Cond:
      Binary(=)
        Ident(cycle)
        Int(1)
    Then:
      Assign
        Target:
          Ident(mode)
        Value:
          Int(10)
    ElsIf:
      Cond:
        Binary(=)
          Ident(cycle)
          Int(2)
      Then:
        Assign
          Target:
            Ident(mode)
          Value:
            Int(20)
    Else:
      Assign
        Target:
          Ident(mode)
        Value:
          Int(30)
  If
    Cond:
      Binary(>)
        Ident(t)
        Int(100)
    Then:
      Assign
        Target:
          Ident(band)
        Value:
          Int(1)
    ElsIf:
      Cond:
        Binary(>)
          Ident(t)
          Int(50)
      Then:
        Assign
          Target:
            Ident(band)
          Value:
            Int(2)
  If
    Cond:
      Binary(>)
        Ident(t)
        Int(10)
    Then:
      Assign
        Target:
          Ident(sign)
        Value:
          Int(1)
    ElsIf:
      Cond:
        Binary(>)
          Ident(t)
          Int(0)
      Then:
        If
          Cond:
            Binary(>)
              Ident(t)
              Int(3)
          Then:
            Assign
              Target:
                Ident(sign)
              Value:
                Int(2)
          Else:
            Assign
              Target:
                Ident(sign)
              Value:
                Int(3)
    Else:
      Assign
        Target:
          Ident(sign)
        Value:
          Int(4)
  If
    Cond:
      Binary(>)
        Ident(t)
        Int(10)
    Then:
      Assign
        Target:
          Ident(legacy)
        Value:
          Int(1)
    Else:
      If
        Cond:
          Binary(>)
            Ident(t)
            Int(3)
        Then:
          Assign
            Target:
              Ident(legacy)
            Value:
              Int(2)
  Assign
    Target:
      Ident(whileZero)
    Value:
      Int(0)
  Assign
    Target:
      Ident(k)
    Value:
      Int(0)
  While
    Cond:
      Binary(>)
        Ident(k)
        Int(0)
    Body:
      Assign
        Target:
          Ident(whileZero)
        Value:
          Binary(+)
            Ident(whileZero)
            Int(1)
      Assign
        Target:
          Ident(k)
        Value:
          Binary(-)
            Ident(k)
            Int(1)
  Assign
    Target:
      Ident(repeatOne)
    Value:
      Int(0)
  Repeat
    Body:
      Assign
        Target:
          Ident(repeatOne)
        Value:
          Binary(+)
            Ident(repeatOne)
            Int(1)
    Until:
      Binary(<)
        Ident(repeatOne)
        Int(100)
  Assign
    Target:
      Ident(sum)
    Value:
      Int(0)
  Assign
    Target:
      Ident(k)
    Value:
      Int(0)
  While
    Cond:
      Binary(<)
        Ident(k)
        Int(5)
    Body:
      Assign
        Target:
          Ident(k)
        Value:
          Binary(+)
            Ident(k)
            Int(1)
      Assign
        Target:
          Ident(sum)
        Value:
          Binary(+)
            Ident(sum)
            Ident(k)
  Assign
    Target:
      Ident(rep)
    Value:
      Int(0)
  Repeat
    Body:
      Assign
        Target:
          Ident(rep)
        Value:
          Binary(+)
            Ident(rep)
            Int(1)
      If
        Cond:
          Binary(=)
            Ident(rep)
            Int(3)
        Then:
          Exit
    Until:
      Binary(>=)
        Ident(rep)
        Int(10)
  Assign
    Target:
      Ident(found)
    Value:
      Int(0)
  For(i)
    Start:
      Int(1)
    End:
      Int(10)
    Do:
      If
        Cond:
          Binary(>)
            Binary(*)
              Ident(i)
              Ident(i)
            Int(20)
        Then:
          Assign
            Target:
              Ident(found)
            Value:
              Ident(i)
          Exit
  Assign
    Target:
      Ident(outerCnt)
    Value:
      Int(0)
  Assign
    Target:
      Ident(innerCnt)
    Value:
      Int(0)
  For(i)
    Start:
      Int(1)
    End:
      Int(3)
    Do:
      Assign
        Target:
          Ident(outerCnt)
        Value:
          Binary(+)
            Ident(outerCnt)
            Int(1)
      For(j)
        Start:
          Int(1)
        End:
          Int(10)
        Do:
          If
            Cond:
              Binary(>)
                Ident(j)
                Int(2)
            Then:
              Exit
          Assign
            Target:
              Ident(innerCnt)
            Value:
              Binary(+)
                Ident(innerCnt)
                Int(1)
  Assign
    Target:
      Ident(spins)
    Value:
      Int(0)
  While
    Cond:
      Bool(TRUE)
    Body:
      Assign
        Target:
          Ident(spins)
        Value:
          Binary(+)
            Ident(spins)
            Int(1)
      If
        Cond:
          Binary(>=)
            Ident(spins)
            Int(4)
        Then:
          Exit
  Assign
    Target:
      Ident(acc)
    Value:
      Int(0)
  Assign
    Target:
      Ident(k)
    Value:
      Int(0)
  While
    Cond:
      Binary(<)
        Ident(k)
        Int(3)
    Body:
      Assign
        Target:
          Ident(k)
        Value:
          Binary(+)
            Ident(k)
            Int(1)
      For(j)
        Start:
          Int(1)
        End:
          Ident(k)
        Do:
          Assign
            Target:
              Ident(acc)
            Value:
              Binary(+)
                Ident(acc)
                Ident(j)
  Assign
    Target:
      Ident(r)
    Value:
      Real(10.0)
  Assign
    Target:
      Ident(halves)
    Value:
      Int(0)
  While
    Cond:
      Binary(>)
        Ident(r)
        Int(1)
    Body:
      Assign
        Target:
          Ident(r)
        Value:
          Binary(/)
            Ident(r)
            Int(2)
      Assign
        Target:
          Ident(halves)
        Value:
          Binary(+)
            Ident(halves)
            Int(1)
  Assign
    Target:
      Ident(flag)
    Value:
      Bool(FALSE)
  Assign
    Target:
      Ident(tries)
    Value:
      Int(0)
  While
    Cond:
      Binary(AND)
        Unary(NOT)
          Ident(flag)
        Binary(<)
          Ident(tries)
          Int(10)
    Body:
      Assign
        Target:
          Ident(tries)
        Value:
          Binary(+)
            Ident(tries)
            Int(1)
      Assign
        Target:
          Ident(flag)
        Value:
          Binary(>)
            Binary(*)
              Ident(tries)
              Int(3)
            Int(10)
  Assign
    Target:
      Ident(digitsZero)
    Value:
      Call
        Callee:
          Ident(Digits)
        Arg
          Int(0)
  Assign
    Target:
      Ident(digitsBig)
    Value:
      Call
        Callee:
          Ident(Digits)
        Arg
          Int(12345)
  CallStmt
    Call
      Callee:
        Ident(tank)
      Arg(inflow :=)
        Int(15)
      Arg(level =>)
        Ident(lvl)
      Arg(steps =>)
        Ident(drained)
  Assign
    Target:
      Ident(pick)
    Value:
      Int(0)
  Assign
    Target:
      Ident(taps)
    Value:
      Int(0)
  While
    Cond:
      Binary(<)
        Ident(pick)
        Int(9)
    Body:
      Assign
        Target:
          Ident(pick)
        Value:
          Binary(+)
            Ident(pick)
            Int(1)
      If
        Cond:
          Binary(=)
            Ident(pick)
            Int(1)
        Then:
          Assign
            Target:
              Ident(taps)
            Value:
              Binary(+)
                Ident(taps)
                Int(1)
        ElsIf:
          Cond:
            Binary(=)
              Ident(pick)
              Int(2)
          Then:
            Assign
              Target:
                Ident(taps)
              Value:
                Binary(+)
                  Ident(taps)
                  Int(10)
        ElsIf:
          Cond:
            Binary(=)
              Ident(pick)
              Int(3)
          Then:
            Exit
        Else:
          Assign
            Target:
              Ident(taps)
            Value:
              Binary(+)
                Ident(taps)
                Int(100)
  Assign
    Target:
      Ident(wOuter)
    Value:
      Int(0)
  Assign
    Target:
      Ident(wInner)
    Value:
      Int(0)
  While
    Cond:
      Binary(<)
        Ident(wOuter)
        Int(4)
    Body:
      Assign
        Target:
          Ident(wOuter)
        Value:
          Binary(+)
            Ident(wOuter)
            Int(1)
      Assign
        Target:
          Ident(wStep)
        Value:
          Int(0)
      While
        Cond:
          Binary(<)
            Ident(wStep)
            Int(10)
        Body:
          Assign
            Target:
              Ident(wStep)
            Value:
              Binary(+)
                Ident(wStep)
                Int(1)
          Assign
            Target:
              Ident(wInner)
            Value:
              Binary(+)
                Ident(wInner)
                Int(1)
          If
            Cond:
              Binary(>=)
                Ident(wStep)
                Int(3)
            Then:
              Exit
  Assign
    Target:
      Ident(rOuter)
    Value:
      Int(0)
  Assign
    Target:
      Ident(rInner)
    Value:
      Int(0)
  Repeat
    Body:
      Assign
        Target:
          Ident(rOuter)
        Value:
          Binary(+)
            Ident(rOuter)
            Int(1)
      Assign
        Target:
          Ident(rStep)
        Value:
          Int(0)
      Repeat
        Body:
          Assign
            Target:
              Ident(rStep)
            Value:
              Binary(+)
                Ident(rStep)
                Int(1)
          Assign
            Target:
              Ident(rInner)
            Value:
              Binary(+)
                Ident(rInner)
                Int(1)
          If
            Cond:
              Binary(>=)
                Ident(rStep)
                Int(3)
            Then:
              Exit
        Until:
          Binary(>=)
            Ident(rStep)
            Int(9)
    Until:
      Binary(>=)
        Ident(rOuter)
        Int(3)
  Assign
    Target:
      Ident(stepsUsed)
    Value:
      Call
        Callee:
          Ident(StepsTo)
        Arg
          Int(20)
  Assign
    Target:
      Ident(grown)
    Value:
      Int(0)
  Repeat
    Body:
      Assign
        Target:
          Ident(grown)
        Value:
          Binary(+)
            Ident(grown)
            Int(1)
    Until:
      Call
        Callee:
          Ident(Ripe)
        Arg
          Ident(grown)
  Assign
    Target:
      Ident(armed)
    Value:
      Bool(TRUE)
  Assign
    Target:
      Ident(paces)
    Value:
      Int(0)
  While
    Cond:
      Ident(armed)
    Body:
      Assign
        Target:
          Ident(paces)
        Value:
