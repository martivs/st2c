            Ident(paces)
            Int(1)
      Assign
        Target:
          Ident(armed)
        Value:
          Binary(<)
            Ident(paces)
            Int(3)
  CallStmt
    Call
      Callee:
        Ident(ramp)
      Arg(target :=)
        Int(10)
      Arg(speed =>)
        Ident(rampSpeed)
      Arg(ticks =>)
        Ident(rampTicks)
      Arg(atTop =>)
        Ident(rampTop)
  If
    Cond:
      Ident(armed)
    Then:
      Assign
        Target:
          Ident(gear)
        Value:
          Int(9)
    ElsIf:
      Cond:
        Member(atTop)
          Ident(ramp)
      Then:
        Assign
          Target:
            Ident(gear)
          Value:
            Int(1)
    ElsIf:
      Cond:
        Call
          Callee:
            Ident(Ripe)
          Arg
            Ident(rampSpeed)
      Then:
        Assign
          Target:
            Ident(gear)
          Value:
            Int(2)
    Else:
      Assign
        Target:
          Ident(gear)
        Value:
          Int(3)
