Program(OpsCase)
  VarBlock(VAR)
    VarDecl(scan, band, hits, ticks, tails : INT)
  Assign
    Target:
      Ident(scan)
    Value:
      Binary(+)
        Ident(scan)
        Int(1)
  Case
    Selector:
      Binary(-)
        Ident(scan)
        Int(2)
    Branch(-2..-1, +1):
      Assign
        Target:
          Ident(band)
        Value:
          Int(7)
    Else:
      Assign
        Target:
          Ident(band)
        Value:
          Int(8)
  Assign
    Target:
      Ident(hits)
    Value:
      Int(0)
  Assign
    Target:
      Ident(ticks)
    Value:
      Int(0)
  Assign
    Target:
      Ident(tails)
    Value:
      Int(0)
  While
    Cond:
      Binary(<)
        Ident(hits)
        Int(3)
    Body:
      Assign
        Target:
          Ident(hits)
        Value:
          Binary(+)
            Ident(hits)
            Int(1)
      Case
        Selector:
          Ident(hits)
        Branch(1):
          Repeat
            Body:
              Assign
                Target:
                  Ident(ticks)
                Value:
                  Binary(+)
                    Ident(ticks)
                    Int(1)
              Exit
            Until:
              Bool(TRUE)
          Assign
            Target:
              Ident(ticks)
            Value:
              Binary(+)
                Ident(ticks)
                Int(10)
        Branch(2):
          Case
            Selector:
              Ident(band)
            Branch(7, 8):
              Exit
          Assign
            Target:
              Ident(ticks)
            Value:
              Binary(+)
                Ident(ticks)
                Int(100)
      Assign
        Target:
          Ident(tails)
        Value:
          Binary(+)
            Ident(tails)
            Int(1)
