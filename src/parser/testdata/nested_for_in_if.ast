Program(NestedForInIf)
  VarDecl(x : INT)
  VarDecl(i : INT)
  VarDecl(total : INT)
  Assign
    Target:
      Ident(x)
    Value:
      Int(7)
  Assign
    Target:
      Ident(total)
    Value:
      Int(0)
  If
    Cond:
      Binary(>)
        Ident(x)
        Int(5)
    Then:
      For(i)
        Start:
          Int(1)
        End:
          Ident(x)
        Do:
          Assign
            Target:
              Ident(total)
            Value:
              Binary(+)
                Ident(total)
                Ident(i)
    Else:
      Assign
        Target:
          Ident(total)
        Value:
          Int(0)
