Program(Example)
  VarBlock(VAR)
    VarDecl(x : INT)
    VarDecl(y : INT)
    VarDecl(sum : INT)
  Assign
    Target:
      Ident(x)
    Value:
      Int(10)
  Assign
    Target:
      Ident(y)
    Value:
      Int(3)
  Assign
    Target:
      Ident(sum)
    Value:
      Int(0)
  For(x)
    Start:
      Int(1)
    End:
      Int(5)
    Do:
      Assign
        Target:
          Ident(sum)
        Value:
          Binary(+)
            Ident(sum)
            Ident(x)
  If
    Cond:
      Binary(>)
        Ident(sum)
        Int(10)
    Then:
      Assign
        Target:
          Ident(y)
        Value:
          Int(1)
    Else:
      Assign
        Target:
          Ident(y)
        Value:
          Int(0)
