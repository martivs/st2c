Program(Example)
  VarDecl(x : INT)
  VarDecl(y : INT)
  VarDecl(sum : INT)
  Assign(x :=)
    Int(10)
  Assign(y :=)
    Int(3)
  Assign(sum :=)
    Int(0)
  For(x)
    Start:
      Int(1)
    End:
      Int(5)
    Do:
      Assign(sum :=)
        Binary(+)
          Ident(sum)
          Ident(x)
  If
    Cond:
      Binary(>)
        Ident(sum)
        Int(10)
    Then:
      Assign(y :=)
        Int(1)
    Else:
      Assign(y :=)
        Int(0)
